{
    "name": "@n3rdw1z4rd/core",
    "version": "0.20.0",
    "description": "core library",
    "main": "dist/index.cjs",
    "module": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        },
        "./three": {
            "import": {
                "types": "./dist/three/index.d.ts",
                "default": "./dist/three/index.js"
            },
            "require": {
                "types": "./dist/three.d.cts",
                "default": "./dist/three.cjs"
            }
        },
        "./vite": {
            "import": {
                "types": "./dist/vite.d.ts",
                "default": "./dist/vite.js"
            },
            "require": {
                "types": "./dist/vite.d.cts",
                "default": "./dist/vite.cjs"
            }
        },
        "./css/*": "./dist/css/*",
        "./dist/*": "./dist/*",
        "./package.json": "./package.json"
    },
    "sideEffects": [
        "*.css"
    ],
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsdown",
        "dev": "tsdown --watch",
        "test": "tsx src/test",
        "prepublishOnly": "npm test && npm run build",
        "test:browser": "node scripts/test-browser.mjs",
        "test:browser:headless": "node scripts/test-browser-headless.mjs",
        "docs": "typedoc",
        "docs:watch": "typedoc --watch"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/n3rdw1z4rd/core.git"
    },
    "keywords": [
        "typescript",
        "browser",
        "game-dev",
        "toolkit",
        "three.js",
        "threejs",
        "webgl",
        "canvas",
        "ecs",
        "entity-component-system",
        "rng",
        "procedural-generation",
        "pathfinding",
        "voxel",
        "particle-system"
    ],
    "author": "",
    "license": "MIT",
    "type": "module",
    "bugs": {
        "url": "https://github.com/n3rdw1z4rd/core/issues"
    },
    "homepage": "https://github.com/n3rdw1z4rd/core#readme",
    "dependencies": {
        "heap-js": "^2.7.1"
    },
    "peerDependencies": {
        "three": "^0.186.1"
    },
    "peerDependenciesMeta": {
        "three": {
            "optional": true
        }
    },
    "devDependencies": {
        "@types/three": "^0.186.0",
        "esbuild": "^0.27.2",
        "playwright-core": "^1.56.1",
        "three": "^0.186.1",
        "tsdown": "^0.23.0",
        "tsx": "^4.23.15",
        "typedoc": "^0.28.20",
        "typescript": "^6.0.3"
    },
    "allowScripts": {
        "esbuild@0.27.2": true,
        "esbuild@0.28.2": true,
        "fsevents@2.3.3": true
    }
}
